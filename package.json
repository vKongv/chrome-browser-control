{
  "name": "chrome-browser-control",
  "version": "0.1.0",
  "type": "module",
  "description": "Local MCP server and Chrome MV3 extension for controlling the current Chrome profile from any stdio MCP host.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vkongv/chrome-browser-control.git"
  },
  "homepage": "https://github.com/vkongv/chrome-browser-control#readme",
  "bugs": {
    "url": "https://github.com/vkongv/chrome-browser-control/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "chrome",
    "browser",
    "browser-control",
    "model-context-protocol",
    "extension",
    "cli"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "cbctl": "./dist/cli/main.js",
    "chrome-browser-control": "./dist/cli/main.js"
  },
  "files": [
    "dist",
    "extension",
    "package.json",
    "README.md"
  ],
  "scripts": {
    "broker": "tsx server/broker-main.ts",
    "mcp": "tsx server/index.ts",
    "start": "tsx server/index.ts",
    "build": "tsc -p tsconfig.build.json && node --check extension/security.js && node --check extension/background.js && node --check extension/content-core.js && node --check extension/content.js && node --check extension/offscreen.js && node --check extension/popup.js",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "benchmark:snapshots": "node benchmarks/compact-snapshot.mjs",
    "benchmark:compact-snapshots": "node benchmarks/compact-snapshot.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.21.3",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "happy-dom": "^20.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.8"
  }
}
